# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Razorpay Configuration (INR currency only)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Security & Master Encryption Key (32 bytes / 64 hex characters)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CONTENT_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Support Email
NEXT_PUBLIC_SUPPORT_EMAIL="support@om.store"
